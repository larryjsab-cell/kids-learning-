# Stripe (https://dashboard.stripe.com/apikeys). Use test keys until launch.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the Stripe webhook endpoint pointing at https://<your-domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# n8n (server-side only). Both workflows check the same x-tinilearners-token header.
N8N_LEAD_WEBHOOK_URL=https://ryzonmedia.app.n8n.cloud/webhook/tinilearners-website-form
N8N_ORDER_WEBHOOK_URL=https://ryzonmedia.app.n8n.cloud/webhook/tinilearners-order
N8N_WEBHOOK_TOKEN=
